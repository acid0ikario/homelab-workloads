{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ingress", "clients", "homelab"],
  "title": "Ingress — Client Analytics",
  "uid": "ingress-client-analytics",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "textbox",
        "label": "Host filter (regex, blank = all)",
        "query": "",
        "current": { "text": ".+", "value": ".+" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total requests",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({namespace=\"ingress-nginx\", host=~\"$host\"}[$__range]))", "datasource": { "type": "loki", "uid": "loki" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Public (Funnel) vs Local",
      "type": "piechart",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (source) (count_over_time({namespace=\"ingress-nginx\", host=~\"$host\"}[$__range]))", "legendFormat": "{{source}}", "instant": true, "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 3,
      "title": "Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum(rate({namespace=\"ingress-nginx\", host=~\"$host\"}[1m]))", "legendFormat": "req/s", "datasource": { "type": "loki", "uid": "loki" } }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Browser",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (browser) (count_over_time({namespace=\"ingress-nginx\", host=~\"$host\"}[$__range]))", "legendFormat": "{{browser}}", "instant": true, "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 5,
      "title": "Operating system",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (os) (count_over_time({namespace=\"ingress-nginx\", host=~\"$host\"}[$__range]))", "legendFormat": "{{os}}", "instant": true, "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 6,
      "title": "Device type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (device) (count_over_time({namespace=\"ingress-nginx\", host=~\"$host\"}[$__range]))", "legendFormat": "{{device}}", "instant": true, "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 7,
      "title": "Status codes",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate({namespace=\"ingress-nginx\", host=~\"$host\"}[1m]))", "legendFormat": "{{status}}", "datasource": { "type": "loki", "uid": "loki" } }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Top client IPs",
      "type": "table",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "topk(15, sum by (remote_addr) (count_over_time({namespace=\"ingress-nginx\", host=~\"$host\"} | json [$__range])))", "instant": true, "format": "table", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 9,
      "title": "Full request detail (IP · method · path · status · UA · lang · referer)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "prettifyLogMessage": true },
      "targets": [
        { "refId": "A", "expr": "{namespace=\"ingress-nginx\", host=~\"$host\"} | json | line_format \"{{.remote_addr}} [{{.source}}/{{.browser}}/{{.os}}] {{.method}} {{.host}}{{.path}} -> {{.status}} | lang:{{.accept_language}} | ref:{{.referer}}\"", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    }
  ]
}
