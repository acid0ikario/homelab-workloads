{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ingress", "clients", "homelab"],
  "title": "Ingress — Client Analytics",
  "uid": "ingress-client-analytics",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "textbox",
        "label": "Host filter (blank = all)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total requests",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [$__range]))",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Unique client IPs",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (remote_addr) (count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [$__range])))",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Public (Funnel) vs Local",
      "type": "piechart",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tailscale_funnel) (count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [$__range]))",
          "legendFormat": "{{tailscale_funnel}}",
          "instant": true,
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [1m]))",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Top client IPs",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (remote_addr) (count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [$__range])))",
          "instant": true,
          "format": "table",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Browser",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (browser) (count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" | label_format browser=`{{ if hasPrefix .user_agent \"curl\" }}curl{{ else if contains .user_agent \"Edg/\" }}Edge{{ else if contains .user_agent \"Chrome\" }}Chrome{{ else if contains .user_agent \"Firefox\" }}Firefox{{ else if contains .user_agent \"Safari\" }}Safari{{ else if contains .user_agent \"bot\" }}Bot{{ else }}Other{{ end }}` [$__range]))",
          "legendFormat": "{{browser}}",
          "instant": true,
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 7,
      "title": "Operating system / device",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (os) (count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" | label_format os=`{{ if contains .user_agent \"iPhone\" }}iOS{{ else if contains .user_agent \"Android\" }}Android{{ else if contains .user_agent \"Windows\" }}Windows{{ else if contains .user_agent \"Mac OS\" }}macOS{{ else if contains .user_agent \"Linux\" }}Linux{{ else }}Other{{ end }}` [$__range]))",
          "legendFormat": "{{os}}",
          "instant": true,
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 8,
      "title": "Status codes",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [1m]))",
          "legendFormat": "{{status}}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Top paths",
      "type": "table",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (path) (count_over_time({namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" [$__range])))",
          "instant": true,
          "format": "table",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 10,
      "title": "Full request detail (IP · method · path · status · UA · lang · referer)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "prettifyLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"ingress-nginx\"} | json | host =~ \"$host.*\" | line_format \"{{.remote_addr}} | {{.method}} {{.host}}{{.path}} -> {{.status}} | UA: {{.user_agent}} | lang: {{.accept_language}} | ref: {{.referer}} | funnel: {{.tailscale_funnel}}\"",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    }
  ]
}
